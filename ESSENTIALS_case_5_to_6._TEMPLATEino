// ==================================================
// ELEC1601 - SCENARIOS 0 TO 6
//
// 0 unknown LEDs 000 does not move
// 1 middle of a long corridor LEDs 001 5 cm forward
// 2 ideal right turn LEDs 010 90 right, drive on
// 3 ideal left turn LEDs 011 90 left, drive on
// 4 dead end LEDs 100 180, drive on
// 5 parallel, close to left wall LEDs 101 nudge centre, reverse level
// 6 parallel, close to right wall LEDs 110 nudge centre, reverse level
//
// On reset: read sensors, show the code for 6 seconds without moving,
// run the escape, stop.
// ==================================================
#include <Servo.h>
// true = stay still and print readings instead of running a scenario
const bool CALIBRATE_MODE = false;
// Set 0-6 to skip detection and run that escape directly. -1 for the demo.
const int FORCE_SCENARIO = -1;
// ==================================================
// PINS
// ==================================================
Servo RightWheelServo;
Servo LeftWheelServo;
const int RightWheelPin = 13, LeftWheelPin = 12;
const int irLedPin = 6, irReceiverPin = 7; // CENTER
const int RightIrLedPin = 2, RightIrReceiverPin = 3; // RIGHT
const int LeftIrLedPin = 10, LeftIrReceiverPin = 11; // LEFT
// LED-R Right = A0 = bit 0, Mid = A1 = bit 1, Left = A2 = bit 2
const int LedPin0 = A0, LedPin1 = A1, LedPin2 = A2;
const bool LED_ACTIVE_LOW = false;
const unsigned long DISPLAY_HOLD_MS = 6000; // spec needs at least 5 seconds
// ==================================================
// SPEEDS AND TUNING
// ==================================================
const int ClockWise = 1300, CounterClockWise = 1700;
const int Stop = 1500;
// Straight driving works in SPEED: distance from 1500. 200 = full, 0 = stopped.
const int FULL_SPEED = 200;
// Wheel calibration for the drift to the right. Applied once, here.
const int DRIFT_TRIM = 75;
const int LEFT_BASE = FULL_SPEED; // 200
const int RIGHT_BASE = FULL_SPEED - DRIFT_TRIM; // 125
// Wall correction. Curving right is the weaker direction, so it gets more gain.
const int STEER_GAIN_RIGHT = 100;
const int STEER_GAIN_LEFT = 60;
const int STEER_MAX_RIGHT = 140;
const int STEER_MAX_LEFT = 100;
const int DEADBAND = 1;
// Movement timings, measured with a ruler
const int TURN_90_MS = 500;
const int TURN_180_MS = 1000;
const int FORWARD_5CM_MS = 700;
const int REENTER_MS = 1200;
const int SLIGHT_TURN_MS = 150; // roughly 25-30 degrees
const int NUDGE_FORWARD_MS = 500;
const int NUDGE_BACK_MS = 500;
// ==================================================
// IR DISTANCE
// ==================================================
// The receiver peaks at 38 kHz and loses sensitivity either side of it, so a
// wall has to be closer to trigger the higher frequencies. Counting the misses
// across the sweep gives a distance from 0 (closest) to 5 (nothing seen).
const long F_START = 38000, F_END = 42000, F_STEP = 1000;
int irDetect(int irLedPin, int irReceiverPin, long frequency)
{
tone(irLedPin, frequency, 8);
delay(1);
int ir = digitalRead(irReceiverPin); // 0 = detected, 1 = nothing
delay(1);
return ir;
}
int irDistance(int irLedPin, int irReceiverPin)
{
int distance = 0;
for (long f = F_START; f <= F_END; f += F_STEP)
{
distance += irDetect(irLedPin, irReceiverPin, f);
}
return distance;
}
// Three reads, middle value. The scenario is decided once, so one noisy
// reading would pick the wrong one.
int irDistanceStable(int irLedPin, int irReceiverPin)
{
int a = irDistance(irLedPin, irReceiverPin);
int b = irDistance(irLedPin, irReceiverPin);
int c = irDistance(irLedPin, irReceiverPin);
if (a > b) {int t = a; a = b; b = t;}
if (b > c) {int t = b; b = c; c = t;}
if (a > b) {int t = a; a = b; b = t;}
return b;

}
// Calibration measured in the lab:
// 0 -> 6.0 cm 3 -> 10 cm
// 1 -> 6.8 cm 4 -> 11 cm
// 2 -> 7.6 cm 5 -> nothing seen
const int NEAR = 2; // this or lower means a wall is close
const int NO_WALL = 5; // nothing seen
const int WALL_TARGET = 2; // reading to hold when only one wall is visible
// Levels of left/right difference that count as off centre rather than
// centred. Each level is about 0.8 cm.
const int OFF_CENTRE_DIFF = 3;
// ==================================================
// LEDS
// ==================================================
void setLeds(byte mask)
{
bool b0 = mask & 0x01;
bool b1 = mask & 0x02;
bool b2 = mask & 0x04;
if (LED_ACTIVE_LOW) {b0 = !b0; b1 = !b1; b2 = !b2;}
digitalWrite(LedPin0, b0 ? HIGH : LOW);
digitalWrite(LedPin1, b1 ? HIGH : LOW);
digitalWrite(LedPin2, b2 ? HIGH : LOW);
}
// Scenario number is shown directly as a 3 bit binary code
void displayScenario(int scenario)
{
Serial.print("Scenario detected: ");
Serial.println(scenario);
setLeds(scenario & 0x07);
delay(DISPLAY_HOLD_MS);
}
// ==================================================
// DRIVING
// ==================================================
void drive(int left, int right, int ms)
{
LeftWheelServo.writeMicroseconds(left);
RightWheelServo.writeMicroseconds(right);
delay(ms);
}
void stopMoving(int ms = 200) {drive(Stop, Stop, ms);}
void turnRight(int ms) {drive(CounterClockWise, CounterClockWise, ms);}
void turnLeft(int ms) {drive(ClockWise, ClockWise, ms);}
// steer > 0 curves right, steer < 0 curves left. One wheel slows while the
// other speeds up, so both directions have equal authority.
void driveForward(int steer = 0)
{
int leftSpeed = constrain(LEFT_BASE - steer, 0, FULL_SPEED);
int rightSpeed = constrain(RIGHT_BASE + steer, 0, FULL_SPEED);
LeftWheelServo.writeMicroseconds(Stop - leftSpeed);
RightWheelServo.writeMicroseconds(Stop + rightSpeed);
}
void driveBackward(int ms)
{
LeftWheelServo.writeMicroseconds(Stop + LEFT_BASE);
RightWheelServo.writeMicroseconds(Stop - RIGHT_BASE);
delay(ms);
stopMoving();
}
// detach() alone can leave the pin stuck high, which the servo reads as a
// command, so the pins are driven low as well.
void servosOff()
{
LeftWheelServo.detach();
RightWheelServo.detach();
pinMode(LeftWheelPin, OUTPUT);
pinMode(RightWheelPin, OUTPUT);
digitalWrite(LeftWheelPin, LOW);
digitalWrite(RightWheelPin, LOW);
}
void servosOn()
{
LeftWheelServo.attach(LeftWheelPin);
RightWheelServo.attach(RightWheelPin);
drive(Stop, Stop, 200);
}
// ==================================================
// WALL CORRECTION
// ==================================================
// How far off centre the robot is, in sensor levels.
// Positive means it needs to move right, negative means left.
int wallError(int leftRead, int rightRead)
{
bool seeLeft = (leftRead < NO_WALL);
bool seeRight = (rightRead < NO_WALL);
int error;
if (seeLeft && seeRight) error = rightRead - leftRead; // balance the two
else if (seeLeft) error = WALL_TARGET - leftRead; // follow one wall
else if (seeRight) error = rightRead - WALL_TARGET;
else return 0; // nothing to see
if (abs(error) <= DEADBAND) return 0;
return error;
}
int steerFromWalls(int leftRead, int rightRead)
{

int error = wallError(leftRead, rightRead);
if (error == 0) return 0;
if (error > 0) return constrain(error * STEER_GAIN_RIGHT, 0, STEER_MAX_RIGHT);
return constrain(error * STEER_GAIN_LEFT, -STEER_MAX_LEFT, 0);
}
// Forward for a set time, correcting off the side walls. This is what keeps
// the robot parallel and within 3 cm of the centre.
void driveForwardCorrected(unsigned long ms)
{
unsigned long start = millis();
while (millis() - start < ms)
{
int l = irDistance(LeftIrLedPin, LeftIrReceiverPin);
int r = irDistance(RightIrLedPin, RightIrReceiverPin);
driveForward(steerFromWalls(l, r));
}
stopMoving();
}
// ==================================================
// DETECTION
// ==================================================
int detectScenario(int frontRead, int leftRead, int rightRead)
{
bool frontNear = (frontRead <= NEAR);
bool leftNear = (leftRead <= NEAR);
bool rightNear = (rightRead <= NEAR);
bool leftNone = (leftRead == NO_WALL);
bool rightNone = (rightRead == NO_WALL);
if (frontNear && leftNear && rightNear) return 4; // walls all round
if (frontNear && leftNear && rightNone) return 2; // opening on the right
if (frontNear && rightNear && leftNone) return 3; // opening on the left
if (frontRead > NEAR) { // corridor ahead
if (leftNone && rightNone) return 0; // open both sides
int diff = leftRead - rightRead; // -ve: left wall closer
if (abs(diff) >= OFF_CENTRE_DIFF) return (diff < 0) ? 5 : 6;
return 1; // sides match, centred
}
return 0;
}
// ==================================================
// ESCAPES
// ==================================================
// 1: 5 cm forward, parallel and centred
void escapeCorridor()
{
driveForwardCorrected(FORWARD_5CM_MS);
}
// 2 and 3: turn into the new corridor and drive in far enough to be parallel
void escapeTurn(bool right)
{
if (right) turnRight(TURN_90_MS);
else turnLeft(TURN_90_MS);
stopMoving(150);
driveForwardCorrected(REENTER_MS);
}
// 4: turn around and drive back out
void escapeDeadEnd()
{
turnRight(TURN_180_MS);
stopMoving(150);
driveForwardCorrected(REENTER_MS);
}
// 5 and 6: parallel but off to one side. Turn away from the near wall, nudge
// forward diagonally, turn back to parallel, then reverse so the robot ends
// level with where it started but closer to the middle.
void escapeOffCentre(bool nearLeftWall)
{
if (nearLeftWall) turnRight(SLIGHT_TURN_MS);
else turnLeft(SLIGHT_TURN_MS);
stopMoving(150);
driveForward();
delay(NUDGE_FORWARD_MS);
stopMoving(150);
if (nearLeftWall) turnLeft(SLIGHT_TURN_MS);
else turnRight(SLIGHT_TURN_MS);
stopMoving(150);
driveBackward(NUDGE_BACK_MS);
}
// ==================================================
// RUN (one shot)
// ==================================================
void runOnce()
{
servosOff(); // nothing may move until the escape starts
int frontRead = irDistanceStable(irLedPin, irReceiverPin);
int leftRead = irDistanceStable(LeftIrLedPin, LeftIrReceiverPin);
int rightRead = irDistanceStable(RightIrLedPin, RightIrReceiverPin);
Serial.print("L: "); Serial.print(leftRead);
Serial.print(" C: "); Serial.print(frontRead);
Serial.print(" R: "); Serial.println(rightRead);
int scenario = detectScenario(frontRead, leftRead, rightRead);
if (FORCE_SCENARIO >= 0) scenario = FORCE_SCENARIO;
displayScenario(scenario); // held still for the required 5+ seconds
if (scenario != 0) servosOn();
switch (scenario) {
case 1: escapeCorridor(); break;
case 2: escapeTurn(true); break;
case 3: escapeTurn(false); break;
case 4: escapeDeadEnd(); break;
case 5: escapeOffCentre(true); break;
case 6: escapeOffCentre(false); break;
default: break; // 0: do not move
}
stopMoving();
servosOff();
Serial.println("Done. Press reset to run again.");
}
// ==================================================
// SETUP
// ==================================================
void setup()
{
// attach() starts sending pulses immediately and an untrimmed servo creeps
// on them, so the pins go low first and attach happens only when needed
servosOff();
pinMode(irReceiverPin, INPUT);
pinMode(LeftIrReceiverPin, INPUT);
pinMode(RightIrReceiverPin, INPUT);
pinMode(irLedPin, OUTPUT);
pinMode(LeftIrLedPin, OUTPUT);
pinMode(RightIrLedPin, OUTPUT);
pinMode(LedPin0, OUTPUT);
pinMode(LedPin1, OUTPUT);
pinMode(LedPin2, OUTPUT);
setLeds(0);
Serial.begin(9600);
if (!CALIBRATE_MODE) runOnce();
}
// ==================================================
// LOOP
// ==================================================
void loop()
{
if (!CALIBRATE_MODE) return; // all the work happened in setup
int centerRead = irDistance(irLedPin, irReceiverPin);
int leftRead = irDistance(LeftIrLedPin, LeftIrReceiverPin);
int rightRead = irDistance(RightIrLedPin, RightIrReceiverPin);
Serial.print("L: "); Serial.print(leftRead);
Serial.print(" C: "); Serial.print(centerRead);
Serial.print(" R: "); Serial.print(rightRead);
Serial.print(" steer: "); Serial.print(steerFromWalls(leftRead, rightRead));
Serial.print(" scen: "); Serial.println(detectScenario(centerRead, leftRead, rightRead));
delay(250);